# Managed by Ansible (role openstint_decoder).
# The OpenStint repo is unsigned ([trusted=yes]). Allow only the decoder
# package from it; block everything else it might publish. The specific
# record comes first because apt uses the first pin that matches.
Package: openstint
Pin: origin "{{ openstint_decoder_apt_origin }}"
Pin-Priority: 500

Package: *
Pin: origin "{{ openstint_decoder_apt_origin }}"
Pin-Priority: -1
