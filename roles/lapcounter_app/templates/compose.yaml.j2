# Managed by Ansible (role lapcounter_app). Edit the role vars, not this file.
# Host networking: lapd reaches the decoder on 127.0.0.1 and the web port is
# reachable on the hotspot / wired side like any host service.
name: lapcounter
services:
  web:
    image: "{{ lapcounter_app_image }}"
    network_mode: host
    restart: unless-stopped
    environment:
      LAPCOUNTER_DB: /var/lib/lapcounter/lapcounter.db
      LAPCOUNTER_DECODER_STALE_S: "{{ lapcounter_app_decoder_stale_s }}"
      OPENSTINT_RC4_DIR: "{{ lapcounter_app_rc4_dir }}"
      # Settings → Link pairs this Pi with a track in RC Race HQ (key + cert in the data volume).
      RCRACEHQ_API_URL: "{{ lapcounter_app_rcracehq_api_url }}"
    # Transponders → Record renames files in the decoder's .rc4 folder; join its group.
    group_add: ["{{ lapcounter_app_rc4_stat.stat.gid }}"]
    volumes:
      - {{ lapcounter_app_data_dir }}:/var/lib/lapcounter
      - {{ lapcounter_app_rc4_dir }}:{{ lapcounter_app_rc4_dir }}
  lapd:
    image: "{{ lapcounter_app_image }}"
    network_mode: host
    restart: unless-stopped
    command: ["python", "-m", "lapcounter.lapd"]
    healthcheck:
      disable: true
    environment:
      LAPCOUNTER_DB: /var/lib/lapcounter/lapcounter.db
      OPENSTINT_ZMQ: "{{ lapcounter_app_decoder_zmq }}"
    volumes:
      - {{ lapcounter_app_data_dir }}:/var/lib/lapcounter
  # Runs heats to time, uploads learned .rc4 files to the shared transponder
  # library and sends the outbox (results, laps, transponders) to RC Race HQ.
  syncd:
    image: "{{ lapcounter_app_image }}"
    network_mode: host
    restart: unless-stopped
    command: ["python", "-m", "lapcounter.syncd"]
    healthcheck:
      disable: true
    environment:
      LAPCOUNTER_DB: /var/lib/lapcounter/lapcounter.db
      OPENSTINT_RC4_DIR: "{{ lapcounter_app_rc4_dir }}"
    volumes:
      - {{ lapcounter_app_data_dir }}:/var/lib/lapcounter
      - {{ lapcounter_app_rc4_dir }}:{{ lapcounter_app_rc4_dir }}:ro
