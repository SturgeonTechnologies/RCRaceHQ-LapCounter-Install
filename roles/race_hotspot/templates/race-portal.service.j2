# Managed by Ansible (role race_hotspot).
[Unit]
Description=Lap counter captive portal (http://{{ race_hotspot_hostname }}/)
After=race-portal-firewall.service NetworkManager.service
Requires=race-portal-firewall.service

[Service]
Environment=PORTAL_GATEWAY={{ race_hotspot_address }}
Environment=PORTAL_PREFIX={{ race_hotspot_prefix }}
Environment=PORTAL_LISTEN={{ '0.0.0.0' if race_hotspot_web_on_eth0 | bool else race_hotspot_address }}
Environment=PORTAL_PORT={{ race_hotspot_portal_port }}
Environment=PORTAL_HOSTNAME={{ race_hotspot_hostname }}
Environment=PORTAL_DOMAIN={{ race_hotspot_domain }}
Environment=PORTAL_TIMEOUT={{ race_hotspot_access_timeout }}
Environment=PORTAL_APP_PORT={{ race_hotspot_app_port | int }}
Environment="PORTAL_TITLE={{ race_hotspot_portal_title }}"
ExecStart=/usr/bin/python3 -I /usr/local/sbin/race-portal
Restart=always
RestartSec=2

DynamicUser=yes
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
